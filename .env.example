# .env.example - copy karo .env mein aur apni values dalo
# Real .env file ko git mein commit mat karo!

# LLM Provider: "gemini", "openai", ya "mock" (testing ke liye)
LLM_PROVIDER=mock

# Gemini settings (Person 3 use karega)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Agent tuning
MAX_REACT_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=120
MAX_CONTEXT_TOKENS=32000

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
